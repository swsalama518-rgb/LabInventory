SECRET_KEY=replace-with-a-random-string
JWT_SECRET_KEY=replace-with-a-different-random-string

# Optional. Leave unset for local dev (uses a local SQLite file).
# In production, set to a Postgres connection string, e.g. Neon's:
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Optional. Restricts signup to one or more email domains, comma-separated,
# e.g. youruniversity.edu,rockets.youruniversity.edu (no "@"). Leave unset
# to allow any email domain.
ALLOWED_EMAIL_DOMAINS=

# Optional. Comma-separated list of allowed frontend origins in production,
# e.g. https://labinventory.onrender.com. Leave unset ("*") for local dev.
CORS_ORIGINS=*

# Optional. Resend API key + sender address for incubation-end reminder
# emails (sent via Resend's HTTP API, not SMTP — most free-tier hosts,
# including Render, block outbound SMTP ports). Leave unset to skip
# sending (the app still works, just no emails go out).
RESEND_API_KEY=
FROM_EMAIL=

# Optional. A random string only you and your external scheduler know, so
# /api/reminders/check can be triggered without a login. Generate one the
# same way as SECRET_KEY above. Required for reminder emails to ever fire.
REMINDER_SECRET=
